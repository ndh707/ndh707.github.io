---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ '/' | absolute_url | xml_escape }}</loc>
  </url>
  <url>
    <loc>{{ site.cv_link | absolute_url | xml_escape }}</loc>
  </url>
  {% for research_page in site.pages %}
  {% if research_page.url contains '/research/' %}
  <url>
    <loc>{{ research_page.url | absolute_url | xml_escape }}</loc>
  </url>
  {% endif %}
  {% endfor %}
</urlset>
